# --- Backend (Spring Boot) ---
SERVER_PORT=8080

# MySQL connection (used by default; matches docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3306/vectasheet?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=0808

# 'update' is fine for local dev; use 'validate' + real migrations in production
DDL_AUTO=update

# CHANGE THIS before deploying anywhere real. Minimum 32 characters recommended.
JWT_SECRET=change-this-super-secret-key-in-production-minimum-32-chars
JWT_ACCESS_TTL_MINUTES=15

# File storage (Files module)
STORAGE_BASE_DIR=./data/uploads
STORAGE_MAX_FILE_SIZE_BYTES=26214400

# --- Frontend (Vite) ---
FRONTEND_URL=http://localhost:5173
